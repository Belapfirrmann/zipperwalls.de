# ---------- Server ----------
# Öffentliche Adresse des Servers (ohne /mcp am Ende)
PUBLIC_URL=https://connector.zipperwalls.de
# Nur für docker-compose (Caddy), gleicher Hostname wie in PUBLIC_URL
DOMAIN=connector.zipperwalls.de
# Passwort für die Anmeldung beim Verbinden in Claude (mind. 12 Zeichen)
ADMIN_PASSWORD=
TIMEZONE=Europe/Berlin

# ---------- Kalender (iCloud) ----------
# Apple ID und app-spezifisches Passwort (account.apple.com > Anmeldung und Sicherheit)
CALDAV_URL=https://caldav.icloud.com
CALDAV_USER=
CALDAV_PASSWORD=
# false = Claude darf Termine nur lesen
ALLOW_CALENDAR_WRITE=true

# ---------- Mail ----------
# iCloud: imap.mail.me.com:993 / smtp.mail.me.com:587, Benutzer = Apple ID oder iCloud Adresse,
# Passwort = dasselbe app-spezifische Passwort.
# Andere Anbieter (IONOS, Strato, ...): deren IMAP/SMTP Daten eintragen.
IMAP_HOST=imap.mail.me.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
# Leer lassen = wie IMAP
SMTP_USER=
SMTP_PASSWORD=
# Absender für Entwürfe und gesendete Mails
MAIL_FROM=Darien Pfirrmann <darien@zipperwalls.de>
# true = Claude darf Mails direkt senden (sonst nur Entwürfe)
ALLOW_SEND=false
